{
  "name": "vizlearn",
  "version": "1.0.0",
  "description": "Interactive visual explainers for AI, ML, Algorithms and Maths.",
  "main": "tailwind.config.js",
  "scripts": {
    "catalog": "python3 tools/build_catalog.py",
    "twconfig": "node tools/merge_tw_config.js",
    "css": "tailwindcss -c tailwind.config.js -i tools/vizlearn.src.css -o assets/vizlearn.css --minify",
    "icons": "python3 tools/build_icons_js.py",
    "og": "python3 tools/build_og_images.py",
    "seo": "python3 tools/build_seo.py",
    "prerender": "python3 tools/build_prerender.py",
    "sitemap": "python3 tools/build_sitemap.py",
    "audit": "python3 tools/audit.py",
    "build": "npm run sequence && npm run catalog && npm run twconfig && npm run css && npm run icons && npm run og && npm run articles && npm run moduleui && npm run seo && npm run prerender && npm run sitemap && npm run checkjs && npm run audit",
    "moduleui": "python3 tools/build_module_ui.py",
    "sequence": "python3 tools/apply_sequence.py",
    "touch": "python3 tools/fix_touch_input.py",
    "checkjs": "node tools/check_inline_js.js",
    "articles": "python3 tools/build_articles.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nashrullah3110/vizlearn.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nashrullah3110/vizlearn/issues"
  },
  "homepage": "https://github.com/nashrullah3110/vizlearn#readme",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "tailwindcss": "^3.4.17"
  },
  "private": true
}
